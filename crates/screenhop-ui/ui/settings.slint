import { Theme } from "theme.slint";
import { StrokeIcon } from "icons.slint";
import { SourceChoice } from "tray_flyout.slint";

global SettingsGlyph {
    out property <string> close: "M6 6 L18 18 M18 6 L6 18";
    out property <string> monitor: "M3 5.5 L21 5.5 L21 17 L3 17 Z M9 20 L15 20 M12 17 L12 20";
    out property <string> source: "M5 8 L18 8 M15 5 L18 8 L15 11 M19 16 L6 16 M9 13 L6 16 L9 19";
    out property <string> sun: "M12 8.5 C14 8.5 15.5 10 15.5 12 C15.5 14 14 15.5 12 15.5 C10 15.5 8.5 14 8.5 12 C8.5 10 10 8.5 12 8.5 M12 3.5 L12 5.5 M12 18.5 L12 20.5 M3.5 12 L5.5 12 M18.5 12 L20.5 12 M6 6 L7.5 7.5 M16.5 16.5 L18 18 M6 18 L7.5 16.5 M16.5 7.5 L18 6";
    out property <string> moon: "M18.5 15.5 C12 17 7 12 8.5 5.5 C5 7 3.5 11.5 5.5 15.5 C8 20 14.5 21 18.5 15.5";
    out property <string> check: "M5 12.5 L9.5 17 L19 7";
}

component SmallButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 34px;
    width: label-text.preferred-width + 30px;
    border-radius: 7px;
    background: primary
        ? (enabled ? (hit.has-hover ? #0c6f39 : Theme.accent) : Theme.subtle)
        : (enabled && hit.has-hover ? Theme.bg2 : Theme.layer);
    border-width: primary && enabled ? 0px : 1px;
    border-color: Theme.ctl-stroke;
    opacity: enabled ? 1 : 0.55;
    animate background { duration: 140ms; }
    hit := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    label-text := Text {
        text: root.label;
        color: primary && enabled ? #ffffff : Theme.text2;
        font-size: 12px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component SourceNameEditor inherits Rectangle {
    in property <string> slot;
    in-out property <string> name;
    in property <string> detail;
    in property <bool> configured;
    callback edited;
    horizontal-stretch: 1;
    height: 92px;
    border-radius: 9px;
    background: Theme.layer2;
    border-width: 1px;
    border-color: Theme.stroke;
    VerticalLayout {
        padding: 10px;
        spacing: 5px;
        HorizontalLayout {
            Text { text: root.slot; color: Theme.text3; font-size: 10px; font-weight: 750; letter-spacing: 0.4px; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                height: 18px;
                width: status-text.preferred-width + 12px;
                border-radius: 9px;
                background: root.configured ? Theme.accent-soft : Theme.warn-bg;
                status-text := Text {
                    text: root.configured ? "Captured" : "Missing";
                    color: root.configured ? Theme.accent-text : Theme.warn-text;
                    font-size: 9.5px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            height: 31px;
            border-radius: 6px;
            background: Theme.layer;
            border-width: 1px;
            border-color: name-input.has-focus ? Theme.accent : Theme.ctl-stroke;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                name-input := TextInput {
                    text <=> root.name;
                    color: Theme.text;
                    font-size: 12px;
                    single-line: true;
                    vertical-alignment: center;
                    edited => { root.edited(); }
                }
            }
        }
        Text { text: root.detail; color: Theme.text3; font-size: 10.5px; overflow: elide; }
    }
}

component ThemeChoice inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    callback clicked;
    horizontal-stretch: 1;
    height: 48px;
    border-radius: 8px;
    background: selected ? Theme.accent-soft : (hit.has-hover ? Theme.layer2 : Theme.layer);
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.ctl-stroke;
    animate background { duration: 140ms; }
    hit := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        spacing: 8px;
        StrokeIcon { width: 17px; height: 17px; tint: selected ? Theme.accent-text : Theme.text2; commands: root.icon; }
        Text { text: root.label; color: selected ? Theme.accent-text : Theme.text2; font-size: 12px; font-weight: 650; vertical-alignment: center; }
        if selected : StrokeIcon { width: 14px; height: 14px; tint: Theme.accent-text; sw: 2.1px; commands: SettingsGlyph.check; }
    }
}

// Only settings that exist in local mode are shown: the selected monitor/two captured inputs,
// rerunning calibration, and the visual theme. There are intentionally no LAN, peer, hotkey, or
// autostart placeholders.
export component Settings inherits Rectangle {
    in-out property <bool> dark <=> Theme.dark;
    in property <string> monitor-name;
    in property <string> monitor-detail;
    in property <[SourceChoice]> sources;
    in property <bool> ready: false;
    in property <int> pending-source: -1;
    in-out property <string> source-a-name;
    in-out property <string> source-b-name;
    in-out property <string> name-message;
    in-out property <int> name-message-kind: 0; // 0 none · 1 saved · 2 error
    callback close();
    callback rerun-setup();
    callback save-source-names();

    property <string> source-a-detail: sources.length > 0 ? sources[0].detail : "Not captured";
    property <string> source-b-detail: sources.length > 1 ? sources[1].detail : "Not captured";

    border-radius: 11px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.stroke;
    drop-shadow-blur: 36px;
    drop-shadow-color: #00000024;
    drop-shadow-offset-y: 12px;
    clip: true;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 12px;
            padding-top: 14px;
            padding-bottom: 13px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "Settings"; color: Theme.text; font-size: 17px; font-weight: 700; }
                Text { text: "Local monitor switching"; color: Theme.text3; font-size: 10.5px; }
            }
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 7px;
                background: close-hit.has-hover ? Theme.subtle : transparent;
                close-hit := TouchArea { clicked => { root.close(); } }
                StrokeIcon { width: 17px; height: 17px; tint: Theme.text2; commands: SettingsGlyph.close; }
            }
        }

        Rectangle { height: 1px; background: Theme.stroke; }

        HorizontalLayout {
            padding: 20px;
            spacing: 18px;

            VerticalLayout {
                horizontal-stretch: 3;
                spacing: 10px;
                Text { text: "MONITOR & SOURCES"; color: Theme.text3; font-size: 10px; font-weight: 750; letter-spacing: 0.5px; }
                Rectangle {
                    height: 75px;
                    border-radius: 10px;
                    background: Theme.layer;
                    border-width: 1px;
                    border-color: Theme.stroke;
                    HorizontalLayout {
                        padding: 13px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 9px;
                                background: root.ready ? Theme.accent-soft : Theme.warn-bg;
                                StrokeIcon { width: 20px; height: 20px; tint: root.ready ? Theme.accent-text : Theme.warn-text; commands: SettingsGlyph.monitor; }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text { text: root.monitor-name; color: Theme.text; font-size: 13.5px; font-weight: 650; overflow: elide; }
                            Text { text: root.monitor-detail; color: Theme.text3; font-size: 10.5px; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: root.ready ? "Ready" : "Setup needed"; color: root.ready ? Theme.accent-text : Theme.warn-text; font-size: 10.5px; font-weight: 700; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 9px;
                    SourceNameEditor {
                        slot: "SOURCE A";
                        name <=> root.source-a-name;
                        detail: root.source-a-detail;
                        configured: root.sources.length > 0 && root.sources[0].configured;
                        edited => { root.name-message = ""; root.name-message-kind = 0; }
                    }
                    SourceNameEditor {
                        slot: "SOURCE B";
                        name <=> root.source-b-name;
                        detail: root.source-b-detail;
                        configured: root.sources.length > 1 && root.sources[1].configured;
                        edited => { root.name-message = ""; root.name-message-kind = 0; }
                    }
                }
                HorizontalLayout {
                    Text {
                        text: root.pending-source >= 0
                            ? "Wait for the current switch to finish before renaming."
                            : root.name-message == ""
                            ? "Rename labels without recapturing either input."
                            : root.name-message;
                        color: root.pending-source >= 0
                            ? Theme.warn-text
                            : root.name-message-kind == 1
                            ? Theme.accent-text
                            : root.name-message-kind == 2 ? Theme.danger-text : Theme.text3;
                        font-size: 10.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton {
                        label: "Save names";
                        primary: true;
                        enabled: root.pending-source < 0;
                        clicked => { root.save-source-names(); }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    Text { text: "Changed a cable, port, or monitor? Capture both inputs again."; color: Theme.text3; font-size: 10.5px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    SmallButton { label: "Rerun setup"; primary: true; clicked => { root.rerun-setup(); } }
                }
            }

            Rectangle { width: 1px; background: Theme.stroke; }

            VerticalLayout {
                horizontal-stretch: 2;
                spacing: 10px;
                Text { text: "THEME"; color: Theme.text3; font-size: 10px; font-weight: 750; letter-spacing: 0.5px; }
                Text { text: "Choose the appearance used by the flyout and setup window."; color: Theme.text2; font-size: 11.5px; wrap: word-wrap; }
                Rectangle { height: 3px; }
                ThemeChoice {
                    label: "Light";
                    icon: SettingsGlyph.sun;
                    selected: !root.dark;
                    clicked => { root.dark = false; }
                }
                ThemeChoice {
                    label: "Dark";
                    icon: SettingsGlyph.moon;
                    selected: root.dark;
                    clicked => { root.dark = true; }
                }
                Rectangle { vertical-stretch: 1; }
            }
        }

        Rectangle { height: 1px; background: Theme.stroke; }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 10px;
            padding-bottom: 10px;
            Text { text: "No network connection is used. Switching stays on this PC."; color: Theme.text3; font-size: 10.5px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            SmallButton { label: "Done"; clicked => { root.close(); } }
        }
    }
}
