import { Theme } from "theme.slint";
import { StrokeIcon } from "icons.slint";

export struct SourceChoice {
    label: string,
    detail: string,
    configured: bool,
}

global FlyoutGlyph {
    out property <string> settings: "M9 9 L15 9 L15 15 L9 15 Z M12 5.5 L12 9 M12 15 L12 18.5 M5.5 12 L9 12 M15 12 L18.5 12 M7.5 7.5 L9.5 9.5 M14.5 14.5 L16.5 16.5 M7.5 16.5 L9.5 14.5 M14.5 9.5 L16.5 7.5";
    out property <string> swap: "M5 8 L18 8 M15 5 L18 8 L15 11 M19 16 L6 16 M9 13 L6 16 L9 19";
    out property <string> alert: "M12 4 L22 19.5 L2 19.5 Z M12 10 L12 14.2";
    out property <string> monitor: "M3 5.5 L21 5.5 L21 17 L3 17 Z M9 20 L15 20 M12 17 L12 20";
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    height: 46px;
    border-radius: 9px;
    background: enabled ? (hit.has-hover ? #0c6f39 : Theme.accent) : Theme.subtle;
    border-width: enabled ? 0px : 1px;
    border-color: Theme.ctl-stroke;
    animate background { duration: 140ms; }

    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 9px;
        StrokeIcon {
            width: 18px;
            height: 18px;
            tint: root.enabled ? #ffffff : Theme.text3;
            sw: 1.9px;
            commands: FlyoutGlyph.swap;
        }
        Text {
            text: root.label;
            color: root.enabled ? #ffffff : Theme.text3;
            font-size: 14px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

component ChoiceButton inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> enabled: true;
    callback clicked;

    height: 58px;
    border-radius: 9px;
    background: hit.has-hover && enabled ? Theme.accent-soft : Theme.layer2;
    border-width: 1px;
    border-color: hit.has-hover && enabled ? Theme.accent-soft-stroke : Theme.ctl-stroke;
    opacity: enabled ? 1 : 0.5;
    animate background { duration: 140ms; }
    animate border-color { duration: 140ms; }

    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        padding-left: 13px;
        padding-right: 13px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: 13px;
            font-weight: 650;
            overflow: elide;
        }
        Text {
            text: root.detail;
            color: Theme.text3;
            font-size: 10.5px;
            overflow: elide;
        }
    }
}

// Compact tray surface: a single monitor and, whenever the current input is known, exactly one
// primary toggle. If detection is inconclusive, both explicit destinations are shown instead of
// guessing which direction "toggle" would take.
export component TrayFlyout inherits Rectangle {
    in property <string> monitor-name;
    in property <string> monitor-detail;
    in property <[SourceChoice]> sources;
    in property <int> active-source: -1;
    in property <int> pending-source: -1;
    in property <bool> ready: false;
    in property <int> status-kind: 0;
    in property <string> status-text;
    in property <string> message;

    callback toggle();
    callback switch-source(int);
    callback open-setup();
    callback open-settings();

    property <string> source-a-label: sources.length > 0 ? sources[0].label : "Source A";
    property <string> source-b-label: sources.length > 1 ? sources[1].label : "Source B";
    property <string> source-a-detail: sources.length > 0 ? sources[0].detail : "Not captured";
    property <string> source-b-detail: sources.length > 1 ? sources[1].detail : "Not captured";
    property <string> active-label: active-source == 0 ? source-a-label : active-source == 1 ? source-b-label : "Unknown input";
    property <string> active-detail: active-source == 0 ? source-a-detail : active-source == 1 ? source-b-detail : "The monitor did not confirm its current source";
    property <string> target-label: active-source == 0 ? source-b-label : source-a-label;
    property <bool> switching: pending-source >= 0;

    border-radius: 11px;
    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.stroke;
    drop-shadow-blur: 34px;
    drop-shadow-color: #00000026;
    drop-shadow-offset-y: 10px;
    clip: true;

    VerticalLayout {
        // Header
        HorizontalLayout {
            padding-left: 15px;
            padding-right: 10px;
            padding-top: 13px;
            padding-bottom: 12px;
            spacing: 10px;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: @linear-gradient(160deg, #117c44 0%, #0c5e32 100%);
                StrokeIcon {
                    width: 18px;
                    height: 18px;
                    tint: #ffffff;
                    sw: 1.8px;
                    commands: FlyoutGlyph.monitor;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.monitor-name;
                    color: Theme.text;
                    font-size: 13.5px;
                    font-weight: 650;
                    overflow: elide;
                }
                Text {
                    text: root.monitor-detail;
                    color: Theme.text3;
                    font-size: 10.5px;
                    overflow: elide;
                }
            }

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 7px;
                background: settings-hit.has-hover ? Theme.subtle : transparent;
                settings-hit := TouchArea { clicked => { root.open-settings(); } }
                StrokeIcon {
                    width: 17px;
                    height: 17px;
                    tint: Theme.text2;
                    commands: FlyoutGlyph.settings;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.stroke; }

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 16px;
            padding-bottom: 14px;
            spacing: 12px;

            if root.ready : Rectangle {
                height: 68px;
                border-radius: 9px;
                background: Theme.layer2;
                border-width: 1px;
                border-color: Theme.stroke;
                HorizontalLayout {
                    padding-left: 13px;
                    padding-right: 13px;
                    spacing: 11px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 31px;
                            height: 31px;
                            border-radius: 16px;
                            background: root.active-source >= 0 ? Theme.accent-soft : Theme.warn-bg;
                            Text {
                                text: root.active-source >= 0 ? "ON" : "?";
                                color: root.active-source >= 0 ? Theme.accent-text : Theme.warn-text;
                                font-size: root.active-source >= 0 ? 9px : 16px;
                                font-weight: 750;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.active-label;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.active-detail;
                            color: Theme.text3;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }

            if root.status-text != "" : Rectangle {
                min-height: root.message == "" ? 35px : 53px;
                border-radius: 8px;
                background: root.status-kind == 4 ? Theme.danger-bg : root.status-kind == 3 ? Theme.warn-bg : root.status-kind == 2 ? Theme.accent-soft : Theme.layer2;
                border-width: 1px;
                border-color: root.status-kind == 4 ? Theme.danger : root.status-kind == 3 ? Theme.warn-stroke : root.status-kind == 2 ? Theme.accent-soft-stroke : Theme.stroke;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 4px;
                            background: root.status-kind == 4 ? Theme.danger : root.status-kind == 3 ? Theme.warn-accent : Theme.accent;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.status-text;
                            color: root.status-kind == 4 ? Theme.danger-text : root.status-kind == 3 ? Theme.warn-text : Theme.text2;
                            font-size: 11.5px;
                            font-weight: 650;
                            wrap: word-wrap;
                        }
                        if root.message != "" : Text {
                            text: root.message;
                            color: root.status-kind == 4 ? Theme.danger-text : root.status-kind == 3 ? Theme.warn-text : Theme.text3;
                            font-size: 10.5px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if !root.ready : PrimaryButton {
                label: "Set up this monitor";
                clicked => { root.open-setup(); }
            }

            if root.ready && root.active-source >= 0 : PrimaryButton {
                label: root.switching
                    ? (root.pending-source == 0 ? "Switching to " + root.source-a-label + "…" : "Switching to " + root.source-b-label + "…")
                    : "Switch to " + root.target-label;
                enabled: !root.switching;
                clicked => { root.toggle(); }
            }

            if root.ready && root.active-source < 0 : VerticalLayout {
                spacing: 7px;
                Text {
                    text: "CHOOSE A DESTINATION";
                    color: Theme.text3;
                    font-size: 10px;
                    font-weight: 750;
                    letter-spacing: 0.45px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    ChoiceButton {
                        horizontal-stretch: 1;
                        label: root.source-a-label;
                        detail: root.source-a-detail;
                        enabled: !root.switching && root.sources.length > 0 && root.sources[0].configured;
                        clicked => { root.switch-source(0); }
                    }
                    ChoiceButton {
                        horizontal-stretch: 1;
                        label: root.source-b-label;
                        detail: root.source-b-detail;
                        enabled: !root.switching && root.sources.length > 1 && root.sources[1].configured;
                        clicked => { root.switch-source(1); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        Rectangle { height: 1px; background: Theme.stroke; }

        HorizontalLayout {
            padding-left: 15px;
            padding-right: 15px;
            padding-top: 10px;
            padding-bottom: 10px;
            Text {
                text: root.ready ? "One monitor · two local inputs" : "Setup is required before switching";
                color: Theme.text3;
                font-size: 10.5px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "Settings";
                color: footer-hit.has-hover ? Theme.accent-text : Theme.text2;
                font-size: 11.5px;
                font-weight: 650;
                vertical-alignment: center;
                footer-hit := TouchArea { clicked => { root.open-settings(); } }
            }
        }
    }
}
