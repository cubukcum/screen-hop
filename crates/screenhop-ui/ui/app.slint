import { Theme } from "theme.slint";
import { TrayFlyout, SourceChoice } from "tray_flyout.slint";
import { SetupWizard, DetectedMonitor } from "onboarding.slint";
import { Settings } from "settings.slint";

export { Theme }

// screen-hop is deliberately a local utility: one selected monitor, two captured inputs, and
// one primary toggle. Rust owns every state transition; this surface never claims that a switch
// succeeded until the backend updates `active-source`.
export component AppWindow inherits Window {
    title: "screen-hop";
    default-font-family: Theme.font;
    background: Theme.bg;

    in-out property <bool> dark <=> Theme.dark;
    in-out property <int> screen: 0; // 0 = flyout · 1 = setup · 2 = settings

    // Local flyout/settings view model.
    in-out property <string> monitor-name: "Studio monitor";
    in-out property <string> monitor-detail: "Local DDC/CI display";
    in-out property <[SourceChoice]> sources: [
        { label: "Desk PC", detail: "DisplayPort · 0x0F", configured: true },
        { label: "Laptop", detail: "HDMI 1 · 0x11", configured: true },
    ];
    in-out property <int> active-source: 0; // -1 = current input could not be identified
    in-out property <int> pending-source: -1; // -1 = no switch in flight
    in-out property <bool> ready: true;
    // 0 ready/neutral · 1 confirmed · 2 switching · 3 inconclusive/warning · 4 error
    in-out property <int> status-kind: 0;
    in-out property <string> status-text: "Ready";
    in-out property <string> message: "";

    // Setup view model. Rust advances the step only after each physical/DDC operation succeeds.
    in-out property <[DetectedMonitor]> detected-monitors: [
        { name: "Studio monitor", detail: "Best identified · NVIDIA DDC path", recommended: true },
    ];
    in-out property <int> selected-monitor: 0;
    in-out property <int> setup-step: 1; // 1 select · 2 capture A · 3 capture/test B · 4 name
    in-out property <bool> setup-busy: false;
    in-out property <string> setup-message: "";
    in-out property <string> source-a-name: "Desk PC";
    in-out property <string> source-b-name: "Laptop";

    callback switch-source(int);
    callback toggle();
    callback open-setup();
    callback open-settings();
    callback close-settings();
    callback setup-continue();
    callback setup-capture-a();
    callback setup-listen-b();
    callback setup-finish();
    callback setup-cancel();

    width: screen == 0 ? 380px : screen == 1 ? 560px : 680px;
    height: screen == 0 ? 320px : screen == 1 ? 520px : 460px;

    if screen == 0 : TrayFlyout {
        width: parent.width;
        height: parent.height;
        monitor-name: root.monitor-name;
        monitor-detail: root.monitor-detail;
        sources: root.sources;
        active-source: root.active-source;
        pending-source: root.pending-source;
        ready: root.ready;
        status-kind: root.status-kind;
        status-text: root.status-text;
        message: root.message;
        toggle => { root.toggle(); }
        switch-source(index) => { root.switch-source(index); }
        open-setup => { root.open-setup(); }
        open-settings => { root.open-settings(); }
    }

    if screen == 1 : SetupWizard {
        width: parent.width;
        height: parent.height;
        detected-monitors: root.detected-monitors;
        selected-monitor <=> root.selected-monitor;
        step: root.setup-step;
        busy: root.setup-busy;
        message: root.setup-message;
        source-a-name <=> root.source-a-name;
        source-b-name <=> root.source-b-name;
        continue => { root.setup-continue(); }
        capture-a => { root.setup-capture-a(); }
        listen-b => { root.setup-listen-b(); }
        finish => { root.setup-finish(); }
        cancel => { root.setup-cancel(); }
    }

    if screen == 2 : Settings {
        width: parent.width;
        height: parent.height;
        dark <=> root.dark;
        monitor-name: root.monitor-name;
        monitor-detail: root.monitor-detail;
        sources: root.sources;
        ready: root.ready;
        close => { root.close-settings(); }
        rerun-setup => { root.open-setup(); }
    }
}
