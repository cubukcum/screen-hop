import { Theme } from "theme.slint";
import { StrokeIcon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

export struct DetectedMonitor {
    name: string,
    detail: string,
    recommended: bool,
}

global SetupGlyph {
    out property <string> monitor: "M3 5.5 L21 5.5 L21 17 L3 17 Z M9 20 L15 20 M12 17 L12 20";
    out property <string> source: "M5 8 L18 8 M15 5 L18 8 L15 11 M19 16 L6 16 M9 13 L6 16 L9 19";
    out property <string> check: "M5 12.5 L9.5 17 L19 7";
    out property <string> alert: "M12 4 L22 19.5 L2 19.5 Z M12 10 L12 14.2";
}

component Button inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 36px;
    width: label-text.preferred-width + 32px;
    border-radius: 7px;
    background: primary
        ? (enabled ? (hit.has-hover ? #0c6f39 : Theme.accent) : Theme.subtle)
        : (enabled && hit.has-hover ? Theme.bg2 : Theme.layer);
    border-width: primary && enabled ? 0px : 1px;
    border-color: Theme.ctl-stroke;
    opacity: enabled ? 1 : 0.5;
    animate background { duration: 140ms; }

    hit := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    label-text := Text {
        text: root.label;
        color: root.primary && root.enabled ? #ffffff : Theme.text2;
        font-size: 12.5px;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StepBadge inherits Rectangle {
    in property <int> index;
    in property <int> current;
    in property <string> label;
    property <bool> complete: current > index;
    property <bool> active: current == index;

    width: 120px;
    height: 44px;
    background: transparent;
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: root.complete || root.active ? Theme.accent : transparent;
            border-width: root.complete || root.active ? 0px : 1px;
            border-color: Theme.ctl-stroke;
            if root.complete : StrokeIcon {
                width: 12px;
                height: 12px;
                tint: #ffffff;
                sw: 2.2px;
                commands: SetupGlyph.check;
            }
            if !root.complete : Text {
                text: "\{root.index}";
                color: root.active ? #ffffff : Theme.text3;
                font-size: 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent-text : Theme.text3;
            font-size: 10px;
            font-weight: root.active ? 700 : 550;
            horizontal-alignment: center;
        }
    }
}

component MonitorOption inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <int> display-number;
    in property <bool> recommended;
    in property <bool> selected;
    callback clicked;

    height: 60px;
    border-radius: 9px;
    background: selected ? Theme.accent-soft : (hit.has-hover ? Theme.layer2 : Theme.layer);
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.stroke;
    animate background { duration: 140ms; }

    hit := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 11px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 7px;
                background: selected ? Theme.accent : Theme.subtle;
                StrokeIcon {
                    width: 17px;
                    height: 17px;
                    tint: selected ? #ffffff : Theme.text2;
                    commands: SetupGlyph.monitor;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: "Option \{root.display-number} · \{root.name}";
                color: Theme.text;
                font-size: 13px;
                font-weight: 650;
                overflow: elide;
            }
            Text {
                text: root.detail;
                color: root.recommended ? Theme.accent-text : Theme.text3;
                font-size: 10.5px;
                font-weight: root.recommended ? 650 : 500;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: selected ? 5px : 1px;
                border-color: selected ? Theme.accent : Theme.ctl-stroke;
                background: Theme.layer;
            }
        }
    }
}

component InstructionCard inherits Rectangle {
    in property <string> eyebrow;
    in property <string> title;
    in property <string> body;
    in property <int> number;

    border-radius: 10px;
    background: Theme.layer;
    border-width: 1px;
    border-color: Theme.stroke;
    HorizontalLayout {
        padding: 16px;
        spacing: 13px;
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 17px;
                background: Theme.accent-soft;
                Text {
                    text: "\{root.number}";
                    color: Theme.accent-text;
                    font-size: 14px;
                    font-weight: 750;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.eyebrow; color: Theme.text3; font-size: 10px; font-weight: 750; letter-spacing: 0.45px; }
            Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 650; wrap: word-wrap; }
            Text { text: root.body; color: Theme.text2; font-size: 11.5px; wrap: word-wrap; }
        }
    }
}

component NameField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    spacing: 5px;
    Text { text: root.label; color: Theme.text2; font-size: 11.5px; font-weight: 650; }
    Rectangle {
        height: 38px;
        border-radius: 7px;
        background: Theme.subtle;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.ctl-stroke;
        HorizontalLayout {
            padding-left: 11px;
            padding-right: 11px;
            input := TextInput {
                text <=> root.value;
                color: Theme.text;
                font-size: 13px;
                single-line: true;
                vertical-alignment: center;
            }
        }
    }
}

component SetupMessageCard inherits Rectangle {
    in property <string> message;

    height: max(42px, message-text.preferred-height + 20px);
    border-radius: 8px;
    background: Theme.warn-bg;
    border-width: 1px;
    border-color: Theme.warn-stroke;
    HorizontalLayout {
        padding: 10px;
        spacing: 8px;
        StrokeIcon { width: 15px; height: 15px; tint: Theme.warn-accent; commands: SetupGlyph.alert; }
        message-text := Text {
            horizontal-stretch: 1;
            text: root.message;
            color: Theme.warn-text;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// Four-step local calibration. Step 3 deliberately says what the app is doing: it waits for a
// physical change, captures B, then attempts to return to A automatically before setup can finish.
export component SetupWizard inherits Rectangle {
    in property <[DetectedMonitor]> detected-monitors;
    in-out property <int> selected-monitor: -1;
    in property <int> step: 1;
    in property <bool> busy: false;
    in property <string> message;
    in-out property <string> source-a-name;
    in-out property <string> source-b-name;

    callback continue();
    callback capture-a();
    callback listen-b();
    callback finish();
    callback cancel();

    // A long monitor list can be scrolled. Every new step must begin at its heading rather than
    // inheriting that offset from the shared scrolling body.
    changed step => { body-scroll.viewport-y = 0px; }

    property <string> selected-name: selected-monitor >= 0 && selected-monitor < detected-monitors.length
        ? detected-monitors[selected-monitor].name
        : "the selected monitor";

    border-radius: 11px;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.stroke;
    drop-shadow-blur: 34px;
    drop-shadow-color: #00000026;
    drop-shadow-offset-y: 10px;
    clip: true;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 14px;
            padding-bottom: 11px;
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "Set up local switching"; color: Theme.text; font-size: 16px; font-weight: 700; }
                Text { text: "One monitor · two sources · this PC only"; color: Theme.text3; font-size: 10.5px; }
            }
            VerticalLayout { alignment: center; Button { label: "Cancel"; enabled: !root.busy; clicked => { root.cancel(); } } }
        }

        Rectangle { height: 1px; background: Theme.stroke; }

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            alignment: center;
            StepBadge { index: 1; current: root.step; label: "Monitor"; }
            StepBadge { index: 2; current: root.step; label: "Source A"; }
            StepBadge { index: 3; current: root.step; label: "Source B"; }
            StepBadge { index: 4; current: root.step; label: "Names"; }
        }

        Rectangle { height: 1px; background: Theme.stroke; }

        body-scroll := ScrollView {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 16px;
                padding-bottom: 12px;
                spacing: 10px;

            if root.step == 1 : VerticalLayout {
                alignment: start;
                spacing: 9px;
                Text { text: "Choose the monitor to control"; color: Theme.text; font-size: 17px; font-weight: 650; }
                Text {
                    text: "Choose the physical screen whose Input / Source button you use to switch between devices. If one row shows its brand and model, try that one first.";
                    color: Theme.text2;
                    font-size: 11.5px;
                    wrap: word-wrap;
                }
                Text {
                    text: "Selecting it and pressing Continue does not change the input; the next step only reads it.";
                    color: Theme.accent-text;
                    font-size: 11px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if root.message != "" : SetupMessageCard { message: root.message; }
                Rectangle { height: 3px; }
                if root.detected-monitors.length == 0 : Rectangle {
                    height: 82px;
                    border-radius: 9px;
                    background: Theme.warn-bg;
                    border-width: 1px;
                    border-color: Theme.warn-stroke;
                    HorizontalLayout {
                        padding: 13px;
                        spacing: 10px;
                        StrokeIcon { width: 17px; height: 17px; tint: Theme.warn-accent; commands: SetupGlyph.alert; }
                        Text { text: "No DDC/CI monitor was found. Enable DDC/CI in the monitor menu, then reopen setup."; color: Theme.warn-text; font-size: 11.5px; wrap: word-wrap; }
                    }
                }
                for monitor[index] in root.detected-monitors : MonitorOption {
                    name: monitor.name;
                    detail: monitor.detail;
                    display-number: index + 1;
                    recommended: monitor.recommended;
                    selected: root.selected-monitor == index;
                    clicked => { root.selected-monitor = index; }
                }
            }

            if root.step == 2 : VerticalLayout {
                alignment: start;
                spacing: 11px;
                Text { text: "Capture source A"; color: Theme.text; font-size: 17px; font-weight: 650; }
                Text { text: "This records the input that is visible right now. It does not switch anything yet."; color: Theme.text2; font-size: 11.5px; wrap: word-wrap; }
                Rectangle { height: 3px; }
                InstructionCard {
                    number: 1;
                    eyebrow: "ON THE MONITOR";
                    title: "Show the first device on " + root.selected-name;
                    body: "Use the monitor's physical Input / Source control if needed. Make sure the picture you want to call source A is visible.";
                }
                InstructionCard {
                    number: 2;
                    eyebrow: "IN SCREEN-HOP";
                    title: "Capture the active input code";
                    body: "screen-hop will read VCP 0x60 and save that value only after the monitor reports it.";
                }
            }

            if root.step == 3 : VerticalLayout {
                alignment: start;
                spacing: 11px;
                Text { text: "Teach source B and verify the return path"; color: Theme.text; font-size: 17px; font-weight: 650; }
                Text { text: "The app must prove that this PC can switch the monitor back after the other input becomes active."; color: Theme.text2; font-size: 11.5px; wrap: word-wrap; }
                Rectangle { height: 3px; }
                InstructionCard {
                    number: 1;
                    eyebrow: "START LISTENING";
                    title: "Then physically switch to the other input";
                    body: "screen-hop waits for a different 0x60 value and records it as source B. Nothing is guessed.";
                }
                InstructionCard {
                    number: 2;
                    eyebrow: "AUTOMATIC SAFETY TEST";
                    title: "screen-hop switches back to source A";
                    body: "Setup continues only after A is confirmed. If the picture does not return, use the monitor's physical Input / Source button to select A; the app may be hidden on B.";
                }
            }

            if root.step == 4 : VerticalLayout {
                alignment: start;
                spacing: 11px;
                Text { text: "Name the two sources"; color: Theme.text; font-size: 17px; font-weight: 650; }
                Text { text: "Use labels you will recognize in the tray. You can change them by rerunning setup."; color: Theme.text2; font-size: 11.5px; wrap: word-wrap; }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: 10px;
                    NameField { horizontal-stretch: 1; label: "Source A"; value <=> root.source-a-name; }
                    NameField { horizontal-stretch: 1; label: "Source B"; value <=> root.source-b-name; }
                }
                Rectangle {
                    height: 61px;
                    border-radius: 9px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent-soft-stroke;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        StrokeIcon { width: 17px; height: 17px; tint: Theme.accent-text; sw: 2px; commands: SetupGlyph.check; }
                        Text { text: "Both source codes were captured and the automatic return test passed."; color: Theme.accent-text; font-size: 11.5px; font-weight: 600; wrap: word-wrap; }
                    }
                }
            }

            if root.step != 1 && root.message != "" : SetupMessageCard { message: root.message; }

            }
        }

        Rectangle { height: 1px; background: Theme.stroke; }

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 12px;
            Text {
                text: root.busy ? (root.step == 3 ? "Listening and testing…" : "Reading the monitor…") : "Step \{root.step} of 4";
                color: root.busy ? Theme.accent-text : Theme.text3;
                font-size: 11px;
                font-weight: root.busy ? 650 : 500;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.step == 1 : Button {
                label: "Continue";
                primary: true;
                enabled: !root.busy && root.selected-monitor >= 0 && root.selected-monitor < root.detected-monitors.length;
                clicked => { root.continue(); }
            }
            if root.step == 2 : Button {
                label: root.busy ? "Capturing…" : "Capture source A";
                primary: true;
                enabled: !root.busy;
                clicked => { root.capture-a(); }
            }
            if root.step == 3 : Button {
                label: root.busy ? "Listening…" : "Listen for source B";
                primary: true;
                enabled: !root.busy;
                clicked => { root.listen-b(); }
            }
            if root.step == 4 : Button {
                label: "Finish setup";
                primary: true;
                enabled: !root.busy && root.source-a-name != "" && root.source-b-name != "";
                clicked => { root.finish(); }
            }
        }
    }
}
